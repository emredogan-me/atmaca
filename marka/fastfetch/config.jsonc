// Atmaca Linux — fastfetch ayarları (sistem geneli: /etc/xdg/fastfetch/config.jsonc).
// fastfetch kendi logo listesinde Atmaca'yı bilmediği için os-release'teki ID_LIKE=fedora
// satırına bakıp Fedora logosunu gösterirdi; burada Atmaca logosunu veriyoruz.
// Kullanıcı ~/.config/fastfetch/config.jsonc yazarsa onunki geçerli olur.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/atmaca/fastfetch-logo.txt",
        "padding": { "top": 1, "right": 2 }
    },
    "display": {
        "color": { "keys": "blue", "title": "blue" }
    }
}
