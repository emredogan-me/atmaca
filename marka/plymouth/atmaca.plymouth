[Plymouth Theme]
Name=Atmaca
Description=Atmaca Linux açılış ekranı: lacivert zemin, ortada logo, altında ince ilerleme çubuğu
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/atmaca
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0d1b2a
BackgroundEndColor=0x0d1b2a
# Dönen simge yerine Fedora'daki gibi uzun, ince ilerleme çubuğu
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.72
ProgressBarWidth=360
ProgressBarHeight=4
ProgressBarBackgroundColor=0x1b263b
ProgressBarForegroundColor=0x3b82f6
MessageBelowAnimation=true

[boot-up]
UseAnimation=false
UseProgressBar=true
UseEndAnimation=false

# Kapanışta ve yeniden başlatmada yalnızca logo; çubuk ve dönen simge yok
[shutdown]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[reboot]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Güncellemeler kuruluyor...
SubTitle=Bilgisayarınızı kapatmayın

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Sistem yükseltiliyor...
SubTitle=Bilgisayarınızı kapatmayın

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Donanım yazılımı güncelleniyor...
SubTitle=Bilgisayarınızı kapatmayın

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Sistem sıfırlanıyor...
SubTitle=Bilgisayarınızı kapatmayın
